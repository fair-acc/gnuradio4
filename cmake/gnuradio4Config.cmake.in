@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# vir-simd is a transitive dep of gnuradio4::vir. When fetched at build time we
# install its headers alongside ours and no find_dependency is needed. When
# found via the system, our exported target references vir-simd::vir-simd and
# downstream must resolve it the same way.
if(@GR4_VIR_SIMD_SYSTEM@)
  find_dependency(vir-simd CONFIG)
endif()

# Optional transitive dependencies of exported targets.
if(@ENABLE_TBB@)
  find_dependency(TBB)
endif()

# gnuradio4::gnuradio-algorithm links cpr::cpr for native (non-Emscripten) HTTP support.
if(@GR_HTTP_ENABLED@ AND NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Emscripten")
  find_dependency(cpr CONFIG)
endif()

# gnuradio4::gr-sdr exposes SoapySDR-backed targets when SoapySDR was found at build time.
if(@GR4_HAS_SOAPYSDR@)
  find_dependency(SoapySDR CONFIG)
endif()

# gnuradio4::gr-libsoundio uses the system libsoundio when found via the local
# FindLibSoundIo.cmake (which is shipped with gnuradio4Config). Re-run that
# Find module on the consumer side so the IMPORTED libsoundio_static target
# is recreated.
if(@GR4_HAS_SYSTEM_LIBSOUNDIO@)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(LibSoundIo)
endif()

# *Plugin SIDE_MODULE artefacts are exported as SHARED IMPORTED. Emscripten's
# platform module disables shared libs by default; re-enable before loading
# Targets so find_package consumers do not need to know this detail.
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Emscripten")
  set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/gnuradio4Targets.cmake")

# gnuradio4-plugin is legacy, it has since been merged with gnuradio4-core
if(TARGET gnuradio4::gnuradio-core AND NOT TARGET gnuradio4::gnuradio-plugin)
  add_library(gnuradio4::gnuradio-plugin ALIAS gnuradio4::gnuradio-core)
endif()

# gnuradio-core-dynload: opt-in runtime plugin loading (MAIN_MODULE on Emscripten).
# Falls back to core when the dynload target was not exported (older installs).
if(TARGET gnuradio4::gnuradio-core AND NOT TARGET gnuradio4::gnuradio-core-dynload)
  add_library(gnuradio4::gnuradio-core-dynload ALIAS gnuradio4::gnuradio-core)
endif()

# Install-tree --post-js path (BUILD_INTERFACE is set on the target at configure time).
# Without this, find_package consumers miss the __stack_pointer / GOT dynlink fixes.
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Emscripten" AND TARGET gnuradio4::gnuradio-core-dynload)
  set(_gr4_dynlink_post_js "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/gnuradio4/gnuradio_dynlink_post.js")
  if(EXISTS "${_gr4_dynlink_post_js}")
    set_property(
      TARGET gnuradio4::gnuradio-core-dynload
      APPEND
      PROPERTY INTERFACE_LINK_OPTIONS "SHELL:--post-js=${_gr4_dynlink_post_js}")
  endif()
  unset(_gr4_dynlink_post_js)
endif()

# Filenames of installed SIDE_MODULE plugins (one per line in the package file), if present.
set(GNURADIO4_WASM_PLUGIN_MANIFEST "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/gnuradio4/wasm_plugins.txt")
if(EXISTS "${GNURADIO4_WASM_PLUGIN_MANIFEST}")
  file(STRINGS "${GNURADIO4_WASM_PLUGIN_MANIFEST}" GNURADIO4_WASM_PLUGIN_FILES)
else()
  set(GNURADIO4_WASM_PLUGIN_FILES "")
  set(GNURADIO4_WASM_PLUGIN_MANIFEST "")
endif()

check_required_components(gnuradio4)
