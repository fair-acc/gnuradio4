# cmake/gnuradio4.pc.in

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: GNU Radio 4.0
Description: GNU Radio 4.0 (GR4) signal-processing framework
Version: @GR4_PKG_VERSION@

Cflags: -I${includedir}
Libs: -L${libdir} -lgnuradio-core -lgnuradio-blocklib-core -lgnuradio-plugin @GR4_PKGCONFIG_EXTRA_LIBS@
