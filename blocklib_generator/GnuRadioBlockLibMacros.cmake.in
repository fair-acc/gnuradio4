# define global block building command

# Emscripten SIDE_MODULE create rules are set in the top-level CMakeLists when EMSCRIPTEN.
# This helper is a no-op if already configured (e.g. find_package consumers that set the rules themselves).
function(gr_emscripten_enable_side_module_support)
  if(NOT EMSCRIPTEN)
    return()
  endif()
  get_property(_gr_side_mod_ready GLOBAL PROPERTY GR_EMSCRIPTEN_SIDE_MODULE_READY)
  if(_gr_side_mod_ready)
    return()
  endif()
  message(WARNING
    "gr_emscripten_enable_side_module_support: SIDE_MODULE create rules were not configured. "
    "Set TARGET_SUPPORTS_SHARED_LIBS and CMAKE_*_CREATE_SHARED_LIBRARY for Emscripten, "
    "or build GNU Radio with the top-level Emscripten toolchain.")
endfunction()

function(gr_emscripten_configure_side_module_plugin PLUGIN_TARGET)
  if(NOT EMSCRIPTEN)
    return()
  endif()
  set_target_properties(
    ${PLUGIN_TARGET}
    PROPERTIES PREFIX "lib"
               SUFFIX ".wasm"
               POSITION_INDEPENDENT_CODE ON)
  target_link_options(
    ${PLUGIN_TARGET}
    PRIVATE
    "SHELL:-sSIDE_MODULE=2"
    "SHELL:-sERROR_ON_UNDEFINED_SYMBOLS=0"
    "SHELL:-sEXPORTED_FUNCTIONS=_gr_plugin_make,_gr_plugin_free")
endfunction()

function(gr_detail_append_file_to MERGE_OUTPUT_FILE MERGE_INPUT_FILE)
  file(READ ${MERGE_INPUT_FILE} CONTENTS)
  file(APPEND ${MERGE_OUTPUT_FILE} "${CONTENTS}")
endfunction()

function(gr_detail_merge_files_into MERGE_OUTPUT_FILE MERGE_INPUT_FILES)
  file(WRITE ${MERGE_OUTPUT_FILE} "")
  foreach(MERGE_INPUT_FILE ${MERGE_INPUT_FILES})
    gr_detail_append_file_to(${MERGE_OUTPUT_FILE} ${MERGE_INPUT_FILE})
  endforeach()
endfunction()

function(gr_generate_block_instantiations LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating block instantiations for ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS" "HOOKS_ONLY")
    set(oneValueArgs REGISTRY_HEADER REGISTRY_INSTANCE MODULE_NAME_BASE SPLIT_BATCH REGISTRY_DECLARATION)
    set(multiValueArgs HEADERS SOURCES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if (NOT CBL_MODULE_NAME_BASE)
        set (MODULE_NAME_BASE ${LIB_NAME})
    else()
        set (MODULE_NAME_BASE ${CBL_MODULE_NAME_BASE})
    endif()

    if (NOT TARGET ${LIB_NAME})
        message(FATAL_ERROR "${LIB_NAME} is not a target")
    endif()

    if (NOT CBL_HEADERS)
        message(FATAL_ERROR "No headers passed to gr_generate_block_instantiations")
    endif()

    if(CBL_SPLIT_BATCH)
        set(EFFECTIVE_SPLIT_BATCH "${CBL_SPLIT_BATCH}")
    else()
        set(EFFECTIVE_SPLIT_BATCH "${GR_SPLIT_BATCH}")
    endif()

    if(GR_SPLIT_BLOCK_INSTANTIATIONS OR CBL_SPLIT_BLOCK_INSTANTIATIONS)
        set(PARSER_SPLIT_FLAG "--split")
        if(EFFECTIVE_SPLIT_BATCH GREATER 1)
            set(PARSER_SPLIT_BATCH_FLAG "--split-batch")
            set(PARSER_SPLIT_BATCH_OPTION "${EFFECTIVE_SPLIT_BATCH}")
        else()
            set(PARSER_SPLIT_BATCH_FLAG "")
            set(PARSER_SPLIT_BATCH_OPTION "")
        endif()
    else()
        set(PARSER_SPLIT_FLAG "")
        set(PARSER_SPLIT_BATCH_FLAG "")
        set(PARSER_SPLIT_BATCH_OPTION "")
    endif()

    if(CBL_REGISTRY_HEADER)
        set(PARSER_REGISTRY_HEADER_FLAG "--registry-header")
        set(PARSER_REGISTRY_HEADER_OPTION ${CBL_REGISTRY_HEADER})
    else()
        set(PARSER_REGISTRY_HEADER_FLAG "")
        set(PARSER_REGISTRY_HEADER_OPTION "")
    endif()

    if(CBL_REGISTRY_INSTANCE)
        set(PARSER_REGISTRY_INSTANCE_FLAG "--registry-instance")
        set(PARSER_REGISTRY_INSTANCE_OPTION ${CBL_REGISTRY_INSTANCE})
    else()
        set(PARSER_REGISTRY_INSTANCE_FLAG "")
        set(PARSER_REGISTRY_INSTANCE_OPTION "")
    endif()

    if(CBL_REGISTRY_DECLARATION)
        set(PARSER_REGISTRY_DECLARATION_FLAG "--registry-declaration")
        set(PARSER_REGISTRY_DECLARATION_OPTION "${CBL_REGISTRY_DECLARATION}")
    else()
        set(PARSER_REGISTRY_DECLARATION_FLAG "")
        set(PARSER_REGISTRY_DECLARATION_OPTION "--ignored-empty-declaration")
    endif()

    if(CBL_HOOKS_ONLY)
        set(PARSER_HOOKS_ONLY_FLAG "--hooks-only")
    else()
        set(PARSER_HOOKS_ONLY_FLAG "")
    endif()

    # directory where gnuradio_4_0_parse_registrations will output .cpp files.
    set(GEN_DIR "${CMAKE_BINARY_DIR}/plugins/${MODULE_NAME_BASE}")
    file(MAKE_DIRECTORY "${GEN_DIR}")
    target_include_directories(${LIB_NAME} PUBLIC ${GEN_DIR})
    target_include_directories(${LIB_NAME} PUBLIC ${CMAKE_BINARY_DIR}/include)

    set(GEN_CPP_LIST "${GEN_DIR}/integrator.cpp")

    foreach(HDR IN LISTS CBL_HEADERS)
        # Try to only run the generation when the header is newer than the last time.
        # Key by MODULE_NAME_BASE so Shared/Static and Plugin (different GEN_DIR / registry)
        # each run the parser once — a shared modified_<HDR> cache would skip Plugin gen.
        set(modified 0)
        file(TIMESTAMP ${HDR} modified "%s")
        string(MAKE_C_IDENTIFIER "${MODULE_NAME_BASE}_${HDR}" _gen_stamp_key)
        # the batch size is compared, not keyed on: keying would leave the previous batch's files on disk
        if (NOT DEFINED modified_${_gen_stamp_key} OR "${modified}" GREATER modified_${_gen_stamp_key}
            OR NOT "${EFFECTIVE_SPLIT_BATCH}_${CBL_HOOKS_ONLY}" STREQUAL "${batch_${_gen_stamp_key}}")
            set(modified_${_gen_stamp_key} ${modified} CACHE STRING "Last generated time" FORCE)
            set(batch_${_gen_stamp_key} "${EFFECTIVE_SPLIT_BATCH}_${CBL_HOOKS_ONLY}" CACHE STRING "Last generated batch size" FORCE)

            get_filename_component(ABS_HDR "${HDR}" ABSOLUTE)
            get_filename_component(BASENAME "${HDR}" NAME_WE)

            # remove any previously generated .cpp files for this header.
            file(GLOB OLD_FILES "${GEN_DIR}/*${BASENAME}*.cpp")
            if(OLD_FILES)
                message(STATUS "[BlockLibMacros] deleting old generated files ${OLD_FILES}")
                file(REMOVE ${OLD_FILES})
            endif()

            file(GLOB OLD_FILES "${GEN_DIR}/*${BASENAME}*.hpp.in")
            if(OLD_FILES)
                message(STATUS "[BlockLibMacros] deleting old generated files ${OLD_FILES}")
                file(REMOVE ${OLD_FILES})
            endif()

            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${HDR})

            message(STATUS "[BlockLibMacros] Generating code for header: ${ABS_HDR} -> ${GEN_DIR} with PARSER_SPLIT_FLAG=${PARSER_SPLIT_FLAG}, other options [ ${PARSER_REGISTRY_HEADER_FLAG} ${PARSER_REGISTRY_HEADER_OPTION} ${PARSER_REGISTRY_INSTANCE_FLAG} ${PARSER_REGISTRY_INSTANCE_OPTION} ]")

            # GnuRadioBlockLibConfig.cmake sets this when GnuRadioBlockLib is found via find_package
            # However when FetchContent is used that doesn't happen, so fall back to the build path
            if (NOT PARSER_EXECUTABLE)
                set(PARSER_EXECUTABLE @PROJECT_BINARY_DIR@/tools_build/gnuradio_4_0_parse_registrations)
            endif()

            # run the parser tool immediately at configuration time.
            message(STATUS "[BlockLibMacros] Running: ${PARSER_EXECUTABLE} ${ABS_HDR} ${GEN_DIR}
                    ${PARSER_SPLIT_FLAG}
                    ${PARSER_REGISTRY_HEADER_FLAG}
                    ${PARSER_REGISTRY_HEADER_OPTION}
                    ${PARSER_REGISTRY_INSTANCE_FLAG}
                    ${PARSER_REGISTRY_INSTANCE_OPTION}")
            execute_process(
                    COMMAND ${PARSER_EXECUTABLE} # command
                    "${ABS_HDR}" "${GEN_DIR}" # paths
                    ${PARSER_SPLIT_FLAG}
                    ${PARSER_SPLIT_BATCH_FLAG}
                    ${PARSER_SPLIT_BATCH_OPTION}
                    ${PARSER_REGISTRY_HEADER_FLAG}
                    ${PARSER_REGISTRY_HEADER_OPTION}
                    ${PARSER_REGISTRY_INSTANCE_FLAG}
                    ${PARSER_REGISTRY_INSTANCE_OPTION}
                    ${PARSER_REGISTRY_DECLARATION_FLAG}
                    "${PARSER_REGISTRY_DECLARATION_OPTION}"
                    ${PARSER_HOOKS_ONLY_FLAG}
                    RESULT_VARIABLE gen_res
                    OUTPUT_VARIABLE gen_out
                    ERROR_VARIABLE gen_err
                    OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_STRIP_TRAILING_WHITESPACE
            )
            message(STATUS "[BlockLibMacros] Output from gnuradio_4_0_parse_registrations for ${ABS_HDR}:\n${gen_out}")
            if(NOT gen_res EQUAL 0)
                message(FATAL_ERROR "Error running gnuradio_4_0_parse_registrations on ${HDR}: ${gen_err}")
            endif()
        endif()

        # Glob for the generated .cpp files.
        file(GLOB GENERATED_FILES "${GEN_DIR}/${BASENAME}*.cpp")
        # message(STATUS "[BlockLibMacros] Globed for generated files in ${GEN_DIR} named ${BASENAME}*.cpp got:\n${GENERATED_FILES}")
        if(NOT GENERATED_FILES)
            # If no .cpp files were generated, create a dummy file.
            set(DUMMY_CPP "${GEN_DIR}/dummy_${BASENAME}.cpp")
            file(WRITE "${DUMMY_CPP}" "// No macros or expansions found for '${BASENAME}'\n")
            list(APPEND GENERATED_FILES "${DUMMY_CPP}")
        endif()

        list(APPEND GEN_CPP_LIST ${GENERATED_FILES})

    endforeach()

        # Merge generated declarations.hpp.in into single declarations.hpp
        # and raw_calls.hpp.in into a single raw_calls.hpp
        message(STATUS "[BlockLibMacros] generating ${GEN_DIR}/declarations.hpp from ${GEN_DIR}/*_declarations.hpp.in")
        file(GLOB DECLARATIONS_FILES "${GEN_DIR}/*_declarations.hpp.in")
        if(DECLARATIONS_FILES)
            gr_detail_merge_files_into(${GEN_DIR}/declarations.hpp "${DECLARATIONS_FILES}")
        endif()

        message(STATUS "[BlockLibMacros] generating ${GEN_DIR}/raw_calls.hpp from ${GEN_DIR}/*_raw_calls.hpp.in")
        file(GLOB RAW_CALLS_FILES "${GEN_DIR}/*_raw_calls.hpp.in")
        if(RAW_CALLS_FILES)
            gr_detail_merge_files_into(${GEN_DIR}/raw_calls.hpp "${RAW_CALLS_FILES}")
        endif()

        set(GENERATED_PUBLIC_HEADER_SOURCE "${GEN_DIR}/${MODULE_NAME_BASE}.hpp")
        if(EXISTS "${GENERATED_PUBLIC_HEADER_SOURCE}")
            set(GENERATED_PUBLIC_HEADER_BUILD_DIR "${CMAKE_BINARY_DIR}/include/gnuradio-4.0")
            set(GENERATED_PUBLIC_HEADER_BUILD_PATH "${GENERATED_PUBLIC_HEADER_BUILD_DIR}/${MODULE_NAME_BASE}.hpp")
            file(MAKE_DIRECTORY "${GENERATED_PUBLIC_HEADER_BUILD_DIR}")
            configure_file("${GENERATED_PUBLIC_HEADER_SOURCE}" "${GENERATED_PUBLIC_HEADER_BUILD_PATH}" COPYONLY)
        endif()

    target_sources(${LIB_NAME} PRIVATE ${GEN_CPP_LIST})
endfunction()

function(gr_add_block_library LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating libraries for ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS" "MAKE_SHARED_LIBRARY" "MAKE_STATIC_LIBRARY" "MAKE_PLUGIN")
    set(oneValueArgs REGISTRY_HEADER REGISTRY_INSTANCE SPLIT_BATCH)
    set(multiValueArgs HEADERS SOURCES LINK_LIBRARIES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(CBL_SPLIT_BLOCK_INSTANTIATIONS)
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "SPLIT_BLOCK_INSTANTIATIONS")
    else()
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "")
    endif()

    if(CBL_SPLIT_BATCH)
      set(SPLIT_BATCH_ARG SPLIT_BATCH ${CBL_SPLIT_BATCH})
    else()
      set(SPLIT_BATCH_ARG "")
    endif()

    # Emscripten packages are exclusive:
    #   INTERNAL_ENABLE_BLOCK_PLUGINS=ON  → SIDE_MODULE *Plugin.wasm only (ci-latest-wasm)
    #   INTERNAL_ENABLE_BLOCK_PLUGINS=OFF → Gr*Blocks*.a only (ci-latest-wasm-static)
    # Native builds may still produce Shared/Static and Plugin together.
    set(_build_shared FALSE)
    set(_build_static FALSE)
    set(_build_plugin FALSE)

    if(CBL_MAKE_SHARED_LIBRARY)
        if(EMSCRIPTEN AND INTERNAL_ENABLE_BLOCK_PLUGINS)
            message(STATUS "[BlockLibMacros] Skipping ${LIB_NAME}Shared on Emscripten plugins package")
        else()
            set(_build_shared TRUE)
        endif()
    endif()
    if(CBL_MAKE_STATIC_LIBRARY)
        if(EMSCRIPTEN AND INTERNAL_ENABLE_BLOCK_PLUGINS)
            message(STATUS "[BlockLibMacros] Skipping ${LIB_NAME}Static on Emscripten plugins package")
        else()
            set(_build_static TRUE)
        endif()
    endif()
    if(CBL_MAKE_PLUGIN)
        if(DEFINED INTERNAL_ENABLE_BLOCK_PLUGINS AND NOT INTERNAL_ENABLE_BLOCK_PLUGINS)
            message(STATUS "[BlockLibMacros] Skipping ${LIB_NAME}Plugin (INTERNAL_ENABLE_BLOCK_PLUGINS=OFF)")
        else()
            set(_build_plugin TRUE)
        endif()
    endif()

    # only this branch creates ${LIB_NAME}Object; the Emscripten plugin-only package (_build_plugin
    # with neither) must not assume it exists
    set(_object_lib_exists FALSE)
    if(_build_shared OR _build_static)
        set(_object_lib_exists TRUE)
        set(OBJECT_LIB_NAME "${LIB_NAME}Object")
        add_library(${OBJECT_LIB_NAME} OBJECT ${CBL_SOURCES})
        gr_generate_block_instantiations(${OBJECT_LIB_NAME}
            HEADERS ${CBL_HEADERS}
            MODULE_NAME_BASE ${LIB_NAME}
            ${SPLIT_BLOCK_INSTANTIATIONS_ARG}
            ${SPLIT_BATCH_ARG})
        target_link_libraries(${OBJECT_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})

        if(GR4_USE_PRECOMPILED_HEADERS)
            target_precompile_headers(${OBJECT_LIB_NAME} PRIVATE <gnuradio-4.0/BlockRegistry.hpp>)
        endif()
    endif()

    if(_build_shared)
        set(SHARED_LIB_NAME "${LIB_NAME}Shared")
        # Emscripten static package: build .a explicitly (no SIDE_MODULE / no SHARED→STATIC warning).
        if(EMSCRIPTEN)
            message(STATUS "[BlockLibMacros] Creating a static archive target ${SHARED_LIB_NAME}")
            add_library(${SHARED_LIB_NAME} STATIC)
        else()
            message(STATUS "[BlockLibMacros] Creating a shared library target ${SHARED_LIB_NAME}")
            add_library(${SHARED_LIB_NAME} SHARED)
        endif()
        if(NOT TARGET gnuradio4::${SHARED_LIB_NAME})
            add_library(gnuradio4::${SHARED_LIB_NAME} ALIAS ${SHARED_LIB_NAME})
        endif()
        target_include_directories(${SHARED_LIB_NAME} PUBLIC $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}/include>
                                                          $<INSTALL_INTERFACE:include>)
        target_sources(${SHARED_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${OBJECT_LIB_NAME}>)
        target_link_libraries(${SHARED_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})
        if(EMSCRIPTEN)
            install(
                TARGETS ${SHARED_LIB_NAME}
                EXPORT gnuradio4Targets
                ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
        else()
            install(
                TARGETS ${SHARED_LIB_NAME}
                EXPORT gnuradio4Targets
                LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
        endif()
    endif()

    if(_build_static)
        set(STATIC_LIB_NAME "${LIB_NAME}Static")
        message(STATUS "[BlockLibMacros] Creating a static library target ${STATIC_LIB_NAME}")
        add_library(${STATIC_LIB_NAME} STATIC)
        if(NOT TARGET gnuradio4::${STATIC_LIB_NAME})
            add_library(gnuradio4::${STATIC_LIB_NAME} ALIAS ${STATIC_LIB_NAME})
        endif()
        target_include_directories(${STATIC_LIB_NAME} PUBLIC $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}/include>
                                  $<INSTALL_INTERFACE:include>)
        target_sources(${STATIC_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${OBJECT_LIB_NAME}>)
        target_link_libraries(${STATIC_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})
        install(
            TARGETS ${STATIC_LIB_NAME}
            EXPORT gnuradio4Targets
            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
    endif()

    if(_build_plugin)
        set(PLUGIN_LIB_NAME "${LIB_NAME}Plugin")
        set(PLUGIN_OBJECT_NAME "${LIB_NAME}PluginObject")
        set(PLUGIN_STUB_DIR "${CMAKE_CURRENT_BINARY_DIR}/${PLUGIN_LIB_NAME}")
        file(MAKE_DIRECTORY "${PLUGIN_STUB_DIR}")
        set(PLUGIN_STUB_HPP "${PLUGIN_STUB_DIR}/gr_plugin_stub.hpp")
        set(PLUGIN_STUB_CPP "${PLUGIN_STUB_DIR}/gr_plugin_stub.cpp")
        file(
            WRITE "${PLUGIN_STUB_HPP}"
            "#pragma once\n"
            "#include <gnuradio-4.0/Plugin.hpp>\n"
            "\n"
            "gr::plugin<>& grPluginInstance();\n"
            "// lets a generated hook forward-declare BlockRegistry instead of including Plugin.hpp\n"
            "gr::BlockRegistry& grPluginRegistry();\n")
        file(
            WRITE "${PLUGIN_STUB_CPP}"
            "#include \"gr_plugin_stub.hpp\"\n"
            "\n"
            "GR_PLUGIN(\"${LIB_NAME}\", \"GNU Radio\", \"LGPL-3.0-or-later\", \"4.0\")\n"
            "\n"
            "gr::BlockRegistry& grPluginRegistry() { return grPluginInstance(); }\n")

        message(STATUS "[BlockLibMacros] Creating a plugin target ${PLUGIN_LIB_NAME}")
        add_library(${PLUGIN_OBJECT_NAME} OBJECT ${CBL_SOURCES} "${PLUGIN_STUB_CPP}")
        # bodies are compiled once by ${OBJECT_LIB_NAME} and linked in below -- except on the
        # Emscripten plugin-only package, where ${OBJECT_LIB_NAME} was never created and this
        # object must compile the full bodies itself
        if(_object_lib_exists)
            set(_PLUGIN_HOOKS_ONLY_ARG HOOKS_ONLY)
        else()
            set(_PLUGIN_HOOKS_ONLY_ARG "")
        endif()
        gr_generate_block_instantiations(${PLUGIN_OBJECT_NAME}
            HEADERS ${CBL_HEADERS}
            MODULE_NAME_BASE ${PLUGIN_LIB_NAME}
            ${SPLIT_BLOCK_INSTANTIATIONS_ARG}
            ${SPLIT_BATCH_ARG}
            ${_PLUGIN_HOOKS_ONLY_ARG}
            REGISTRY_HEADER
            gnuradio-4.0/Plugin.hpp
            REGISTRY_INSTANCE
            "grPluginRegistry()"
            REGISTRY_DECLARATION
            "gr::BlockRegistry& grPluginRegistry()")
        # scoped to the stub itself: force-including it target-wide would drag Plugin.hpp into every hook
        set_source_files_properties("${PLUGIN_STUB_CPP}" PROPERTIES COMPILE_OPTIONS "-include${PLUGIN_STUB_HPP}")
        target_link_libraries(${PLUGIN_OBJECT_NAME} PUBLIC
            gnuradio4::gnuradio-core
            gnuradio4::gnuradio-blocklib-core
            gnuradio4::gnuradio-plugin
            ${CBL_LINK_LIBRARIES})

        # no precompiled header: building one costs more than the hooks it would precompile

        if(EMSCRIPTEN)
            gr_emscripten_enable_side_module_support()
        endif()

        add_library(${PLUGIN_LIB_NAME} SHARED)
        if(NOT TARGET gnuradio4::${PLUGIN_LIB_NAME})
            add_library(gnuradio4::${PLUGIN_LIB_NAME} ALIAS ${PLUGIN_LIB_NAME})
        endif()
        target_include_directories(${PLUGIN_LIB_NAME} PUBLIC
            $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}/include>
            $<INSTALL_INTERFACE:include>)
        if(_object_lib_exists)
            target_sources(${PLUGIN_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${PLUGIN_OBJECT_NAME}>
                                                      $<TARGET_OBJECTS:${OBJECT_LIB_NAME}>)
        else()
            target_sources(${PLUGIN_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${PLUGIN_OBJECT_NAME}>)
        endif()

        if(EMSCRIPTEN)
            # Host MAIN_MODULE provides gnuradio-core; only embed non-host static deps (e.g. exprtk).
            target_include_directories(${PLUGIN_LIB_NAME} PRIVATE
                $<TARGET_PROPERTY:${PLUGIN_OBJECT_NAME},INTERFACE_INCLUDE_DIRECTORIES>)
            target_compile_definitions(${PLUGIN_LIB_NAME} PRIVATE
                $<TARGET_PROPERTY:${PLUGIN_OBJECT_NAME},INTERFACE_COMPILE_DEFINITIONS>)
            foreach(_plugin_dep IN LISTS CBL_LINK_LIBRARIES)
                if(TARGET ${_plugin_dep})
                    get_target_property(_dep_type ${_plugin_dep} TYPE)
                    if(_dep_type STREQUAL "INTERFACE_LIBRARY")
                        get_target_property(_iface_libs ${_plugin_dep} INTERFACE_LINK_LIBRARIES)
                        if(_iface_libs)
                            foreach(_iface IN LISTS _iface_libs)
                                if(TARGET ${_iface})
                                    get_target_property(_iface_type ${_iface} TYPE)
                                    if(_iface_type STREQUAL "STATIC_LIBRARY" AND NOT _iface MATCHES "gnuradio-core")
                                        target_link_libraries(${PLUGIN_LIB_NAME} PRIVATE
                                            "$<LINK_LIBRARY:WHOLE_ARCHIVE,${_iface}>")
                                    endif()
                                endif()
                            endforeach()
                        endif()
                    elseif(_dep_type STREQUAL "STATIC_LIBRARY" AND NOT _plugin_dep MATCHES "gnuradio-core")
                        target_link_libraries(${PLUGIN_LIB_NAME} PRIVATE
                            "$<LINK_LIBRARY:WHOLE_ARCHIVE,${_plugin_dep}>")
                    endif()
                endif()
            endforeach()
            gr_emscripten_configure_side_module_plugin(${PLUGIN_LIB_NAME})
            # Record installed basename for share/gnuradio4/wasm_plugins.txt (host manifest).
            set_property(GLOBAL APPEND PROPERTY GR4_WASM_PLUGIN_FILES "lib${PLUGIN_LIB_NAME}.wasm")
        else()
            # Same pattern as Shared/Static: objects via TARGET_OBJECTS above; do not
            # PUBLIC-link the OBJECT target or install(EXPORT) requires it in the set.
            target_link_libraries(${PLUGIN_LIB_NAME} PUBLIC
                gnuradio4::gnuradio-core
                gnuradio4::gnuradio-blocklib-core
                gnuradio4::gnuradio-plugin
                ${CBL_LINK_LIBRARIES})
        endif()

        install(
            TARGETS ${PLUGIN_LIB_NAME}
            EXPORT gnuradio4Targets
            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins
            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins
            RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
    endif()

    if(_build_shared OR _build_static)
        install(FILES "${CMAKE_BINARY_DIR}/include/gnuradio-4.0/${LIB_NAME}.hpp"
            DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/gnuradio-4.0")
    endif()

    # TODO Install pkgconfig files, CMake files for finding the package,
    # header for blocklib init
endfunction()

function(gr_add_block_plugin LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating plugin ${LIB_NAME}")
        return()
    endif()

    if(DEFINED INTERNAL_ENABLE_BLOCK_PLUGINS AND NOT ${INTERNAL_ENABLE_BLOCK_PLUGINS})
        message(WARNING "INTERNAL_ENABLE_BLOCK_PLUGINS is set to Off, not generating plugin ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS" "NO_INSTALL")
    set(oneValueArgs _NO_ONE_VALUE_ARGS)
    set(multiValueArgs HEADERS SOURCES LINK_LIBRARIES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(CBL_SPLIT_BLOCK_INSTANTIATIONS)
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "SPLIT_BLOCK_INSTANTIATIONS")
    else()
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "")
    endif()

    set(OBJECT_LIB_NAME "${LIB_NAME}")
    add_library(${OBJECT_LIB_NAME} OBJECT
        ${CBL_SOURCES}
    )
    gr_generate_block_instantiations(${OBJECT_LIB_NAME}
        HEADERS ${CBL_HEADERS}
        SOURCES ${CBL_SOURCES}
        LINK_LIBRARIES ${CBL_LINK_LIBRARIES}
        MODULE_NAME_BASE ${LIB_NAME}
        ${SPLIT_BLOCK_INSTANTIATIONS_ARG}
        REGISTRY_DECLARATION
        "#include <gnuradio-4.0/Plugin.hpp>\ngr::plugin<>& grPluginInstance()"
        REGISTRY_HEADER
        gnuradio-4.0/Plugin.hpp
        REGISTRY_INSTANCE
        "grPluginInstance()")
    target_link_libraries(${OBJECT_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core gnuradio4::gnuradio-plugin ${CBL_LINK_LIBRARIES})

    set(PLUGIN_LIB_NAME "${LIB_NAME}Plugin")
    message(STATUS "[BlockLibMacros] Creating a plugin target ${PLUGIN_LIB_NAME}")
    if(EMSCRIPTEN)
        gr_emscripten_enable_side_module_support()
    endif()
    add_library(${PLUGIN_LIB_NAME} SHARED)
    target_link_libraries(${PLUGIN_LIB_NAME} ${OBJECT_LIB_NAME})
    if(EMSCRIPTEN)
        gr_emscripten_configure_side_module_plugin(${PLUGIN_LIB_NAME})
        if(NOT CBL_NO_INSTALL)
            set_property(GLOBAL APPEND PROPERTY GR4_WASM_PLUGIN_FILES "lib${PLUGIN_LIB_NAME}.wasm")
        endif()
    endif()
    if(NOT CBL_NO_INSTALL)
        install(
            TARGETS ${PLUGIN_LIB_NAME}
            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins
            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins
            RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
    endif()

    # TODO Install pkgconfig files, CMake files for finding the package,
    # header for blocklib init

endfunction()
